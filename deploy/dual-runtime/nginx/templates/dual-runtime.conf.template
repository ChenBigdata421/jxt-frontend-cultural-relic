    }

    # WVP 通用通道 API → 转发到 WVP 容器（含端口改写，play 接口返回 ZLM 内部端口）
    location ^~ /api/common/ {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Accept-Encoding "";
        sub_filter ":80/rtp/" ":${ZLM_PORT}/rtp/";
        sub_filter_once off;
        sub_filter_types application/json;
        proxy_pass ${WVP_UPSTREAM};
    }

    # WVP 视频监控 API → 转发到 WVP 容器
    location ^~ /api/device/ {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_pass ${WVP_UPSTREAM};
    }

    # WVP play API — rewrite ZLM stream URLs from Docker port 80 to host port
    location ^~ /api/play/ {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
