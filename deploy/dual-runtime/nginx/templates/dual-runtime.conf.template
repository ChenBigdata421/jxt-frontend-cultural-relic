map ${DOLLAR}request_method ${DOLLAR}media_backend {
    GET     ${EVIDENCE_QUERY_UPSTREAM};
    default ${EVIDENCE_COMMAND_UPSTREAM};
}

map ${DOLLAR}request_method ${DOLLAR}archives_backend {
    GET     ${EVIDENCE_QUERY_UPSTREAM};
    default ${EVIDENCE_COMMAND_UPSTREAM};
}

map ${DOLLAR}request_method ${DOLLAR}archive_media_relations_backend {
