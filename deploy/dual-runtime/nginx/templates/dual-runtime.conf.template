server {
    listen       80;
    listen  [::]:80;
    server_name  ${BUSINESS_SERVER_NAME};

    # 业务站静态资源
    location / {
        root   /usr/share/nginx/html/business;
        index  index.html index.htm;
        try_files ${DOLLAR}uri ${DOLLAR}uri/ /index.html;

        location ~* \.(js|css)$ {
            root   /usr/share/nginx/html/business;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        }
    }

    location /uploads/ {
        alias /uploads/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 仪表盘概览接口 → 转发到 evidence-query
    location ^~ /api/v1/dashboard {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${EVIDENCE_QUERY_UPSTREAM};
    }

    # 统计分析接口 → 转发到 evidence-query（只读）
