}

map ${DOLLAR}request_method ${DOLLAR}writ_media_relations_backend {
    GET     ${EVIDENCE_QUERY_UPSTREAM};
    default ${EVIDENCE_COMMAND_UPSTREAM};
}

map ${DOLLAR}request_method ${DOLLAR}process_backend {
    default ${PROCESS_MANAGEMENT_UPSTREAM};
}

map ${DOLLAR}request_method ${DOLLAR}documents_backend {
