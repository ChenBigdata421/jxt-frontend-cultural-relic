}

map ${DOLLAR}request_method ${DOLLAR}incidentrecord_media_relations_backend {
    GET     ${EVIDENCE_QUERY_UPSTREAM};
    default ${EVIDENCE_COMMAND_UPSTREAM};
}

map ${DOLLAR}request_method ${DOLLAR}incidentrecord_media_info_backend {
    GET     ${EVIDENCE_QUERY_UPSTREAM};
    default ${EVIDENCE_COMMAND_UPSTREAM};
}

map ${DOLLAR}request_method ${DOLLAR}cases_backend {
