        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}media_backend;
    }

    location ^~ /api/v1/archives {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}archives_backend;
    }

    location ^~ /api/v1/archive-media-relations {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}archive_media_relations_backend;
    }

    location ^~ /api/v1/incidentRecords {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}incidentRecords_backend;
    }

    location ^~ /api/v1/incidentrecord-media-relations {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}incidentrecord_media_relations_backend;
    }

    location ^~ /api/v1/incidentrecord-media-info {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}incidentrecord_media_info_backend;
    }

    location ^~ /api/v1/cases {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}cases_backend;
    }

    location ^~ /api/v1/case-media-relations {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}case_media_relations_backend;
    }

    location ^~ /api/v1/evidence-source-media {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}evidence_source_media_backend;
    }

    location ^~ /api/v1/evidence-media {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}evidence_media_backend;
    }

    location ^~ /api/v1/writs {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}writs_backend;
    }

    location ^~ /api/v1/writ-media-relations {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}writ_media_relations_backend;
    }

    location ^~ /api/v1/workflows {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}process_backend;
    }

    location ^~ /api/v1/instances {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}process_backend;
    }

    location ^~ /api/v1/tasks {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}process_backend;
    }

    location ^~ /api/v1/ws {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;

        # WebSocket 特定配置
        proxy_http_version 1.1;
        proxy_set_header Upgrade ${DOLLAR}http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;

        proxy_pass ${DOLLAR}process_backend;
    }

    location ^~ /api/v1/files {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}documents_backend;
    }

    location ^~ /api/v1/documents {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${DOLLAR}documents_backend;
    }

    location /api {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${SECURITY_MANAGEMENT_UPSTREAM};
    }

    location /static/uploadfile {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${SECURITY_MANAGEMENT_UPSTREAM};
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html/business;
    }

    location ~ /\. {
        deny all;
    }

    client_max_body_size 10M;
}

server {
    listen       80;
    listen  [::]:80;
    server_name  ${PLATFORM_SERVER_NAME};

    # 平台站静态资源
    location / {
        root   /usr/share/nginx/html/platform;
        index  index.html index.htm;
        try_files ${DOLLAR}uri ${DOLLAR}uri/ /index.html;
    }

    # 平台站仅代理平台后端 API（避免误走业务 /api 兜底）
    location ^~ /api/v1/ {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${PLATFORM_UPSTREAM};
    }

    # 平台站静态文件（上传的文件等）
    location /static/uploadfile {
        proxy_set_header Host ${DOLLAR}host;
        proxy_set_header X-Real-IP ${DOLLAR}remote_addr;
        proxy_set_header X-Forwarded-For ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${DOLLAR}scheme;
        proxy_set_header Authorization ${DOLLAR}http_authorization;
        proxy_pass ${PLATFORM_UPSTREAM};
    }
}
